<UserControl x:Class="Lintel.Stash.ShelfSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Lintel.Core.Controls;assembly=Lintel.Core"
             xmlns:local="clr-namespace:Lintel.Stash"
             AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid Margin="0,2,0,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <TextBlock x:Name="Summary" Style="{DynamicResource Notch.Caption}" VerticalAlignment="Center" />
            <Button x:Name="ClearButton" Style="{DynamicResource Notch.PillButton}" Content="Clear" Padding="8,2" MinHeight="20"
                    HorizontalAlignment="Right" Click="OnClear" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ShelfTile}">
                        <Border x:Name="Tile" Width="76" Height="68" Margin="0,0,6,6" CornerRadius="10" Background="{DynamicResource Notch.Surface}"
                                Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}" Cursor="Hand"
                                PreviewMouseLeftButtonDown="OnTileDown" PreviewMouseMove="OnTileMove" MouseLeftButtonUp="OnTileUp" MouseRightButtonUp="OnTileMenu">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="6,2">
                                    <Grid Height="28">
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Style="{DynamicResource Notch.Icon}" Text="{Binding Glyph}" FontSize="20" Visibility="{Binding GlyphVisibility}"
                                                   Foreground="{DynamicResource Notch.Accent}" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Style="{DynamicResource Notch.Caption}" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="26" TextAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Notch.Text}" />
                                </StackPanel>
                                <Button x:Name="Remove" Style="{DynamicResource Notch.IconButton}" Content="{x:Static c:Glyphs.Close}" Width="18" Height="18"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" Opacity="0" ToolTip="Remove from shelf" Click="OnRemove" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Notch.SurfaceHover}" />
                                <Setter TargetName="Remove" Property="Opacity" Value="1" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="EmptyState" Grid.Row="1" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Notch.ControlStroke}" Margin="0,0,0,6" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{DynamicResource Notch.Icon}" Text="{x:Static c:Glyphs.Tray}" FontSize="20" Foreground="{DynamicResource Notch.TextTertiary}" />
                <TextBlock Style="{DynamicResource Notch.Caption}" Text="Drop files, links or text here" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="DropHint" Grid.RowSpan="2" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Notch.Accent}" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#1A7C9CFF" Margin="0,0,0,6">
            <TextBlock Style="{DynamicResource Notch.Body}" Text="Drop to add to the shelf" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
