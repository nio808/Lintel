<!-- The AI section, dense: 9.5 / 11 px labels, 12–14 px numbers, a 20 px hero, small rings and meters. Theme keys are
     DynamicResource: NotchTheme lives in the notch window's resources, not App's. -->
<UserControl x:Class="Lintel.Agents.UI.AgentsSectionView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Lintel.Agents.UI"
             xmlns:c="clr-namespace:Lintel.Core.Controls;assembly=Lintel.Core"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="False"
             FontFamily="{DynamicResource Notch.Font}" FontSize="11" Foreground="{DynamicResource Notch.Text}">
    <UserControl.Resources>
        <l:Show x:Key="Show" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Notch.Surface}" />
            <Setter Property="BorderBrush" Value="#0DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,9,10,10" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style x:Key="BadgeGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Notch.IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Notch.TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="7,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource Notch.TextTertiary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Notch.TextFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1,5,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Bone" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Height" Value="7" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <DataTemplate x:Key="LegendDot">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,1,4,0" />
                <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="{DynamicResource Notch.TextSecondary}" />
                <TextBlock Text="{Binding Value}" FontSize="9.5" Style="{StaticResource Num}" Margin="4,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Limits: one card per account, one ring per window -->
        <DataTemplate DataType="{x:Type l:LimitsCardVm}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Badge}" Background="{Binding SoftBrush}">
                            <l:ProviderMark Width="10" Height="10" Provider="{Binding Provider}" Tint="{Binding Brush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="7,0,2,0" />
                        <l:PulseDot Grid.Column="2" Width="12" Height="12" DotSize="4" HorizontalAlignment="Left" Fill="{Binding Brush}"
                                    IsPulsing="{Binding IsWorking}" Visibility="{Binding IsWorking, Converter={StaticResource Show}}" ToolTip="Working now" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Background="{Binding SoftBrush}" Visibility="{Binding Plan, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding Plan}" Style="{StaticResource ChipText}" Foreground="{Binding Brush}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#2EF5B83D" Visibility="{Binding IsStale, Converter={StaticResource Show}}">
                                <TextBlock Text="Last known" Style="{StaticResource ChipText}" Foreground="{DynamicResource Tone.Warning}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#33FF5C5C" Visibility="{Binding IsBlocked, Converter={StaticResource Show}}">
                                <TextBlock Text="Limit reached" Style="{StaticResource ChipText}" Foreground="{DynamicResource Tone.Critical}" />
                            </Border>
                            <Button Style="{DynamicResource Notch.IconButton}" Width="20" Height="20" Focusable="False" Margin="4,0,-4,0" Command="{Binding RefreshCommand}" ToolTip="{Binding RefreshTip}">
                                <Grid>
                                    <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Notch.IconFont}" FontSize="10" Foreground="{DynamicResource Notch.TextTertiary}"
                                               Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource Show}, ConverterParameter=!}" />
                                    <l:Spinner Width="10" Height="10" Stroke="{DynamicResource Notch.TextSecondary}"
                                               Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource Show}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Footer}" Foreground="{Binding FooterBrush}" FontSize="9.5" Margin="0,8,0,0" LineHeight="12"
                               TextWrapping="Wrap" MaxHeight="24" TextTrimming="CharacterEllipsis" ToolTip="{Binding Footer}"
                               Visibility="{Binding Footer, Converter={StaticResource Show}}" />
                    <Grid Margin="0,10,0,0">
                        <TextBlock l:Markup.Text="{Binding Message}" TextWrapping="Wrap" FontSize="10.5" LineHeight="15" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Notch.TextSecondary}" Visibility="{Binding Message, Converter={StaticResource Show}}" />
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Opacity="{Binding Dim}" Background="Transparent" ToolTip="{Binding Tip}" Margin="2,0">
                                        <Grid Width="42" Height="42" HorizontalAlignment="Center">
                                            <c:RingGauge Value="{Binding Percent}" Pace="{Binding PacePercent}" Stroke="{Binding Fill}" Thickness="3.5" />
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Num}" FontSize="11.5" Foreground="{Binding ValueBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,1" />
                                        </Grid>
                                        <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Countdown}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Notch.TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- API value -->
        <DataTemplate DataType="{x:Type l:SpendCardVm}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Badge}" Background="#263DDC84">
                            <TextBlock Text="&#xE8C7;" Style="{StaticResource BadgeGlyph}" Foreground="{DynamicResource Tone.Success}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="API value" Style="{StaticResource CardTitle}" />
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Chips}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Background="{Binding Background}" ToolTip="{Binding Tip}">
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource ChipText}" Foreground="{Binding Brush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Tokens}" Style="{StaticResource Num}" FontSize="12" />
                            <TextBlock Text="tokens" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Requests}" Style="{StaticResource Num}" FontSize="12" />
                            <TextBlock Text="requests" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel ToolTip="Share of prompt tokens read from cache">
                            <TextBlock Text="{Binding CacheHit}" Style="{StaticResource Num}" FontSize="12" />
                            <TextBlock Text="cached" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel ToolTip="What cache reads saved against full input prices">
                            <TextBlock Text="{Binding Saved}" Style="{StaticResource Num}" FontSize="12" Foreground="{DynamicResource Tone.Success}" />
                            <TextBlock Text="saved" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </UniformGrid>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Notch.Stroke}" Margin="0,8,0,0" />
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock ToolTip="{Binding ValueTip}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsLoading, Converter={StaticResource Show}, ConverterParameter=!}">
                            <Run Text="{Binding Value, Mode=OneWay}" FontFamily="{DynamicResource Notch.DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                 Typography.NumeralAlignment="Tabular" /><Run Text="  " /><Run Text="{Binding PeriodText, Mode=OneWay}" FontSize="9.5"
                                 Foreground="{DynamicResource Notch.TextTertiary}" />
                        </TextBlock>
                        <TextBlock Margin="0,8,0,6" Text="Reading logs…" Style="{StaticResource Caption}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource Show}}" />
                        <l:SplitBar Segments="{Binding Segments}" Height="4" Margin="0,5,0,0" />
                        <ItemsControl ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource LegendDot}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Working now -->
        <DataTemplate DataType="{x:Type l:LiveCardVm}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Badge}" Background="#267C9CFF">
                            <TextBlock Text="&#xE768;" Style="{StaticResource BadgeGlyph}" Foreground="{DynamicResource Notch.Accent}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Working now" Style="{StaticResource CardTitle}" />
                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding More}" Style="{StaticResource Caption}" Margin="18,2,0,0"
                               Visibility="{Binding More, Converter={StaticResource Show}}" />
                    <Grid Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,0,0,-7"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource Show}, ConverterParameter=!}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7" Background="Transparent" ToolTip="{Binding Tip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <l:ProviderMark Width="10" Height="10" Provider="{Binding Provider}" Tint="{Binding Brush}" HorizontalAlignment="Left" Margin="1,1,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Project}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Elapsed}" Style="{StaticResource Num}" FontSize="12" Foreground="{Binding Brush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource Show}}">
                            <TextBlock Text="&#xE708;" FontFamily="{DynamicResource Notch.IconFont}" FontSize="14" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Notch.TextTertiary}" />
                            <TextBlock Text="All quiet" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,1"
                                       Foreground="{DynamicResource Notch.TextSecondary}" />
                            <TextBlock Text="Sessions show up while an agent works" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Trend (full width) -->
        <DataTemplate DataType="{x:Type l:TrendCardVm}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Badge}" Background="#26F5B83D">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource BadgeGlyph}" Foreground="{DynamicResource Tone.Warning}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Trend" Style="{StaticResource CardTitle}" />
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource LegendDot}" VerticalAlignment="Center"
                                      Margin="4,0,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Grid.Column="3" Text="{Binding Caption}" FontSize="10" Style="{StaticResource Num}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Notch.TextSecondary}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <l:TrendChart Height="56" Bars="{Binding Bars}" PartBrushes="{Binding PartBrushes}" HoveredIndex="{Binding HoveredIndex}" />
                        <TextBlock Text="Reading logs…" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource Show}}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="{Binding AxisStart}" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding AxisMiddle}" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AxisEnd}" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Top models / projects -->
        <DataTemplate DataType="{x:Type l:ShareCardVm}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeBox" Style="{StaticResource Badge}" Background="#26A855D8">
                            <TextBlock x:Name="Glyph" Text="&#xE950;" Style="{StaticResource BadgeGlyph}" Foreground="#C792EA" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                        <TextBlock Grid.Column="2" Text="{Binding PeriodText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="19" Background="Transparent" ToolTip="{Binding Tip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="Auto" MinWidth="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Display}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Height="4" CornerRadius="2" Background="#14FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Height="4" CornerRadius="2" Background="{Binding Brush}" Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Num}" FontSize="10.5" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Notch.TextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,6" Visibility="{Binding IsEmpty, Converter={StaticResource Show}}" />
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="projects">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE8B7;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="#5FB3A8" />
                    <Setter TargetName="BadgeBox" Property="Background" Value="#265FB3A8" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: status line, period, refresh -->
        <Grid Height="24" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <l:PulseDot Width="14" Height="14" DotSize="6" Margin="-1,0,0,0" Fill="{Binding StatusBrush}" IsPulsing="{Binding IsWorking}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="5,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}">
                <Run Text="{Binding Status, Mode=OneWay}" FontFamily="{DynamicResource Notch.TextFont}" FontSize="12" FontWeight="SemiBold" /><Run
                     Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Notch.TextSecondary}" />
            </TextBlock>
            <ListBox Grid.Column="2" Style="{DynamicResource Notch.Segmented}" SelectedIndex="{Binding PeriodIndex}" VerticalAlignment="Center"
                     Focusable="False" Visibility="{Binding Mode, Converter={StaticResource Show}, ConverterParameter=cards}">
                <ListBoxItem Content="Today" />
                <ListBoxItem Content="7 days" />
                <ListBoxItem Content="30 days" />
            </ListBox>
            <Button Grid.Column="3" Style="{DynamicResource Notch.IconButton}" Margin="4,0,-4,0" VerticalAlignment="Center" Focusable="False"
                    Command="{Binding RefreshCommand}" ToolTip="{Binding RefreshTip}">
                <Grid>
                    <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Notch.IconFont}" FontSize="12" Foreground="{DynamicResource Notch.TextSecondary}"
                               Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource Show}, ConverterParameter=!}" />
                    <l:Spinner Width="12" Height="12" Stroke="{DynamicResource Notch.TextSecondary}"
                               Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource Show}}" />
                </Grid>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          PanningMode="VerticalOnly" Visibility="{Binding Mode, Converter={StaticResource Show}, ConverterParameter=cards}">
                <Grid x:Name="CardGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
            <Rectangle x:Name="BottomFade" Height="22" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#E0000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- First index pass: the shape of what is coming -->
            <Grid x:Name="Skeleton" Visibility="{Binding Mode, Converter={StaticResource Show}, ConverterParameter=loading}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Height="124">
                    <StackPanel>
                        <Border Style="{StaticResource Bone}" Width="18" Height="18" CornerRadius="5" Margin="0,0,0,12" />
                        <UniformGrid Rows="1" Columns="3">
                            <Ellipse Width="42" Height="42" Stroke="#14FFFFFF" StrokeThickness="3.5" />
                            <Ellipse Width="42" Height="42" Stroke="#14FFFFFF" StrokeThickness="3.5" />
                            <Ellipse Width="42" Height="42" Stroke="#14FFFFFF" StrokeThickness="3.5" />
                        </UniformGrid>
                        <Border Style="{StaticResource Bone}" Width="90" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Height="124">
                    <StackPanel>
                        <Border Style="{StaticResource Bone}" Width="18" Height="18" CornerRadius="5" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Bone}" Width="80" Height="16" />
                        <Border Style="{StaticResource Bone}" Height="4" HorizontalAlignment="Stretch" Margin="0,4,0,12" />
                        <Border Style="{StaticResource Bone}" Width="140" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" VerticalAlignment="Top" Height="110">
                    <Grid>
                        <Border Style="{StaticResource Bone}" Width="18" Height="18" CornerRadius="5" VerticalAlignment="Top" />
                        <UniformGrid Rows="1" Columns="24" VerticalAlignment="Bottom" Height="56" x:Name="BoneBars" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Nothing on this PC yet -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Margin="0,0,0,16"
                        Visibility="{Binding Mode, Converter={StaticResource Show}, ConverterParameter=empty}">
                <Border Width="36" Height="36" CornerRadius="10" Background="#1A7C9CFF" HorizontalAlignment="Center">
                    <l:ProviderMark Width="16" Height="16" Provider="Claude" Tint="{DynamicResource Notch.Accent}" />
                </Border>
                <TextBlock Text="No coding agents found yet" FontFamily="{DynamicResource Notch.TextFont}" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,3" />
                <TextBlock Text="Lintel reads local logs of Claude, Codex, Copilot and OpenCode, and your plan limits once you allow it."
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="10.5" LineHeight="15" Foreground="{DynamicResource Notch.TextSecondary}" />
                <ItemsControl ItemsSource="{Binding EmptyLines}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Notch.Surface}" CornerRadius="6" Padding="9,5" Margin="0,0,0,4">
                                <TextBlock l:Markup.Text="{Binding}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource Notch.TextSecondary}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
